# Server
PORT=4982
LOG_LEVEL=info
APP_ENV=development

# Rate limit
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# grok.com base (HAR-proven)
GROK_BASE_URL=https://grok.com

# Cookies — preferred: Netscape export from browser
# Chrome extension "Get cookies.txt LOCALLY" while logged into https://grok.com
GROK_COOKIE_FILE=/path/to/grok.com_cookies.txt

# Or paste full Cookie header (must include sso=...; sso-rw=...)
# GROK_COOKIES=sso=...; sso-rw=...; x-userid=...; cf_clearance=...

# Legacy X placeholders (unused by grok.com — ignore)
# GROK_AUTH_TOKEN=
# GROK_CT0=

# Session / retry
GROK_REFRESH_INTERVAL=30
GROK_MAX_RETRIES=3
