# Server
PORT=4982
LOG_LEVEL=info
APP_ENV=development

# Rate limit
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# grok.com base (HAR-proven)
GROK_BASE_URL=https://grok.com

# ── Cookies: pilih 1 path ──────────────────────────────────────────
#
# (A) Netscape file — export browser, full dump OK (runtime filter essential)
# GROK_COOKIE_FILE=/path/to/grok.com_cookies.txt
#
# (B) Script-friendly per cookie (disarankan buat automation / CI)
#    minimal: GROK_SSO + GROK_SSO_RW + GROK_USER_ID + GROK_CF_CLEARANCE
GROK_SSO=
GROK_SSO_RW=
GROK_USER_ID=
GROK_CF_CLEARANCE=
# optional:
# GROK_CF_BM=
# GROK_DEVICE_ID=
#
# (C) One-line Cookie header (kalau udah punya string siap)
# GROK_COOKIES=sso=...; sso-rw=...; x-userid=...; cf_clearance=...
#
# Prioritas: GROK_COOKIE_FILE di-load dulu; GROK_COOKIES / per-cookie
# merge ke Pairs (raw overrides file). GROK_COOKIES menang atas compose
# per-cookie env. Header() hanya kirim essential names.

# Legacy X placeholders (unused by grok.com — ignore)
# GROK_AUTH_TOKEN=
# GROK_CT0=

# Session / retry
GROK_REFRESH_INTERVAL=30
GROK_MAX_RETRIES=3
